# Copiar este archivo como .env (en la raíz) y completar los valores.

# --- Base de datos (Neon) ---
# Connection string de Neon: Dashboard > Connect > copiar la URL
DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require

# --- Motor de IA (Groq, API compatible con OpenAI) ---
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_reemplazar_por_tu_key
# Modelo de chat elegido de la lista de modelos de Groq
AI_MODEL=

# --- API ---
PORT=3000
